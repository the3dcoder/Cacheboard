# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# Nothing here is required to run the server; each secret only enables the
# feature that uses it. The dashboard itself works with no backend at all.

# ---- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0

# Shared secret the dashboard must send as "Authorization: Bearer <token>".
# Generate something long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leaving this empty makes the server refuse every /proxy and /token request.
DASHBOARD_TOKEN=

# Exact origins allowed to call this server, comma-separated. Must match the
# browser's origin exactly (scheme + host + port).
#   http://localhost:8787                          served by this server
#   http://homeassistant.local:8123                served from Home Assistant
ALLOWED_ORIGINS=http://localhost:8787

# Serve the dashboard itself from this server.
#
# Do NOT set this when using Docker — the Dockerfile already points it at
# /dashboard, and an entry here (even an empty one) overrides that and
# silently turns static hosting off. Only set it for a bare `node server.mjs`,
# e.g. STATIC_DIR=..

# ---- OpenAI (the only provider that truly blocks browser calls) -------------
# Covers API-key spend only. There is no API for ChatGPT Plus/consumer
# quota, so those cards stay manual no matter what.
OPENAI_API_KEY=
OPENAI_ORG_ID=

# ---- Generic proxy ---------------------------------------------------------
# For any future host that blocks browsers. One host, one header.
CUSTOM_PROXY_HOST=
CUSTOM_PROXY_HEADER=
CUSTOM_PROXY_VALUE=

# ---- OAuth refresh ---------------------------------------------------------
# Do the OAuth flow once in the dashboard, then paste the refresh token here.
# The server keeps it alive from then on; rotated tokens are saved to
# state.json automatically. The browser never sees a refresh token again.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REFRESH_TOKEN=

# Extra providers wired and ready if you ever want them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ---- Local LLM usage (Claude Code transcripts) ------------------------------
# Claude Code writes a JSONL transcript per session containing per-message
# token counts and the model name. Reading them gives you real per-model usage
# — including Fable tracked separately — for free: no API calls, no spend.
#
# There is no API for your 5-hour or weekly subscription caps; they aren't
# published anywhere. These cards therefore show consumption against a target
# you set, not a percentage of an unknown limit. Claude Code only — your
# claude.ai web/mobile chat usage is not in these files.
#
# Two settings, and they must agree:
#   CLAUDE_PROJECTS_HOST_DIR = the path ON YOUR MACHINE (compose mounts it)
#   CLAUDE_PROJECTS_DIR      = where it lands INSIDE the container
#
# Windows (forward slashes):  C:/Users/you/.claude/projects
# macOS / Linux:              /home/you/.claude/projects
#
# The mount is read-only, and the endpoint returns integers only — never
# message content. Leave both blank to keep transcripts out of the container.
CLAUDE_PROJECTS_HOST_DIR=
CLAUDE_PROJECTS_DIR=/transcripts

# ---- Claude plan limits (session + weekly caps) ----------------------------
# The card that mirrors Claude Code's /usage. Reads the OAuth token already on
# this machine and calls Anthropic's usage endpoint.
#
# UNDOCUMENTED endpoint - Anthropic can change or withdraw it without notice.
# When that happens the card reports the failure instead of a stale number.
#
# Two paths, and they must agree:
#   CLAUDE_CREDENTIALS_HOST_FILE = path ON YOUR MACHINE (compose mounts it)
#   CLAUDE_CREDENTIALS_FILE      = where it lands INSIDE the container
# Windows: C:/Users/you/.claude/.credentials.json   (forward slashes)
# macOS/Linux: /home/you/.claude/.credentials.json
#
# Mounted read-only. The server extracts one access token, makes a single
# outbound call, and returns integers - the token never reaches the browser.
# Leave both blank to keep credentials out of the container entirely.
CLAUDE_CREDENTIALS_HOST_FILE=
CLAUDE_CREDENTIALS_FILE=/creds/.credentials.json
# Must identify as claude-code/<version> or the endpoint answers 429 forever.
CLAUDE_CODE_USER_AGENT=claude-code/2.1.219

# ---- Security self-assessment ----------------------------------------------
# YOUR OWN hosts only. Targets are read from here and never from an HTTP
# request, so the server can't be pointed at anything you didn't list.
# Leave a line blank and that check simply reports as unconfigured.

# Hosts to port-scan (TCP connect only — nothing privileged).
# SECURITY_HOSTS=192.168.1.10,192.168.1.20,nas.local

# Optional. Defaults to a list aimed at dev / IoT / 3D-print / self-hosted-AI
# networks (MQTT, Moonraker, Ollama, Portainer, databases, VNC…).
# SECURITY_PORTS=22,80,443,8123,11434

# Hosts for certificate expiry. "host" assumes :443, or give "host:port".
# SECURITY_TLS_HOSTS=nas.local:443,homeassistant.local:8123

# Your own web services, checked for missing security headers.
# SECURITY_HTTP_URLS=http://nas.local,http://printer.local
